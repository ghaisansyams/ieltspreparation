# ── AI provider ─────────────────────────────────────────────────────────────
# Everything AI-powered (Generate Vocabulary, PDF import, AI Tutor, IELTS
# feedback, "Use This Word", mini stories) goes through ONE provider picked here.
# Leave the keys empty and the app still runs: games, spaced repetition,
# CSV/Excel/TXT import and the library all work offline.
#
# anthropic | openai-compatible   (unset = first provider that has a key)
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# Any OpenAI-compatible Chat Completions endpoint (OpenAI, OpenRouter, Groq, Ollama…)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ── Cloud sync (optional) ──────────────────────────────────────────────────
# Without these the app stores everything in this browser (IndexedDB).
# With them you can sign in on Settings → Cloud sync and your vocabulary
# follows you across devices. Run supabase/migrations/*.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── API protection (recommended when deployed without Supabase) ────────────
# When set, every /api/ai/* call must send this value (Settings → AI access).
# When Supabase is configured, a signed-in session is required instead.
APP_ACCESS_TOKEN=
